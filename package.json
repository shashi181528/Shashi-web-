{
  "name": "goodkind-android",
  "version": "1.0.0",
  "private": true,
  "description": "Together We Are dating app",
  "scripts": {
    "build:app": "node scripts/prepare-web.cjs && esbuild script.js --bundle --platform=browser --format=iife --target=es2020 --outfile=www/app.js",
    "android:sync": "npm run build:app && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/geolocation": "8.2.5",
    "@capacitor/camera": "8.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "^0.25.0"
  }
}
